# API Configuration
ENVIRONMENT=development
PROJECT_NAME="Amex ConciergeAI"
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amex_concierge
# Or explicitly define the URL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amex_concierge

# Redis Configuration (For Caching and LangGraph Checkpointer)
REDIS_URL=redis://localhost:6379/0

# Amadeus Flight API Credentials
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# Twilio SMS / WhatsApp Notification Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Security Configurations
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
